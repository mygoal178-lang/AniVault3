{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/sitemap.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/anilist/search.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "api/anilist/top.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "api/anilist/season-now.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "api/anilist/genres.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "api/anilist/anime/[malId]/index.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "api/anilist/anime/[malId]/characters.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "api/db/health.ts": {
      "maxDuration": 10,
      "memory": 512
    },
    "api/admin/stats.ts": {
      "maxDuration": 15,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).jpeg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.bunny.net; img-src 'self' data: blob: https: http:; font-src 'self' data: https://fonts.gstatic.com https://fonts.bunny.net; connect-src 'self' https://*.supabase.co https://graphql.anilist.co https://www.google-analytics.com https://vitals.vercel-insights.com https://va.vercel-scripts.com wss://*.supabase.co; frame-src 'self' https:; media-src 'self' blob: https: http:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/db/health",
      "destination": "/api/db/health"
    },
    {
      "source": "/api/admin/stats",
      "destination": "/api/admin/stats"
    },
    {
      "source": "/api/health",
      "destination": "/api"
    },
    {
      "source": "/api/requests",
      "destination": "/api"
    },
    {
      "source": "/api/requests/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/anime",
      "destination": "/api"
    },
    {
      "source": "/api/anime/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/episodes/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/jikan/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
